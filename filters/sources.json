{
  "maxRulesPerBlocker": 150000,
  "lists": {
    "easylist.txt": { "url": "https://easylist.to/easylist/easylist.txt", "license": "GPL-3.0 / CC BY-SA 3.0" },
    "easyprivacy.txt": { "url": "https://easylist.to/easylist/easyprivacy.txt", "license": "GPL-3.0 / CC BY-SA 3.0" },
    "advblock.txt": { "url": "https://easylist-downloads.adblockplus.org/advblock.txt", "license": "CC BY 3.0 (RU AdList)" },
    "rinse.txt": { "license": "own" }
  },
  "blockers": {
    "Ads": {
      "output": "Extensions/Blockers/Ads/blockerList.json",
      "sources": [
        { "file": "easylist.txt", "cosmetic": false },
        { "file": "advblock.txt", "cosmetic": false },
        { "file": "rinse.txt", "cosmetic": false }
      ]
    },
    "Privacy": {
      "output": "Extensions/Blockers/Privacy/blockerList.json",
      "sources": [{ "file": "easyprivacy.txt", "cosmetic": false }]
    },
    "Cosmetic": {
      "output": "Extensions/Blockers/Cosmetic/blockerList.json",
      "sources": [
        { "file": "easylist.txt", "network": false },
        { "file": "advblock.txt", "network": false },
        { "file": "easyprivacy.txt", "network": false },
        { "file": "rinse.txt", "network": false }
      ]
    }
  }
}
